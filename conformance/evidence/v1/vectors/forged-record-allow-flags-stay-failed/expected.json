{
  "vector": "forged-record-allow-flags-stay-failed",
  "description": "Every allowance flag on a failing chain: still failed, exit 3.",
  "status": "shipped",
  "export": "forged-record",
  "flags": {
    "runner_keys": [
      "keys/runner.pub"
    ],
    "log_key": "keys/log.pub",
    "log_origin": "numinance.test/log",
    "allow_unanchored": true,
    "allow_incomplete": true,
    "allow_unsigned": true
  },
  "keys": [
    "keys/log.pub",
    "keys/runner.pub"
  ],
  "expect": {
    "level": "failed",
    "exit_code": 3,
    "finding_codes": [
      "chain_broken"
    ],
    "target": {
      "level_enum": "failed",
      "weakened_by_flags": []
    }
  },
  "covers": [
    "level:failed",
    "exit:3",
    "finding:chain_broken",
    "rule:allow-flags-never-rescue-a-failure"
  ]
}
