{
  "vector": "abandoned-with-an-attestation",
  "description": "An attestation file beside the chain of an Abandoned change, with no manifest: the attestation does not match the chain and a change that has an attestation needs a manifest.",
  "status": "shipped",
  "export": "abandoned-with-an-attestation",
  "flags": {
    "runner_keys": [
      "keys/runner.pub"
    ],
    "log_key": "keys/log.pub",
    "log_origin": "numinance.test/log",
    "allow_unsigned": true
  },
  "keys": [
    "keys/log.pub",
    "keys/runner.pub"
  ],
  "expect": {
    "level": "failed",
    "exit_code": 3,
    "finding_codes": [
      "attestation_mismatch",
      "manifest_missing"
    ],
    "target": {
      "level_enum": "failed",
      "weakened_by_flags": []
    }
  },
  "covers": [
    "level:failed",
    "exit:3",
    "finding:attestation_mismatch",
    "finding:manifest_missing",
    "rule:presence-checks-need-no-chain"
  ]
}
